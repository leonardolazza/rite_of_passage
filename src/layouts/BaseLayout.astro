---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { siteConfig } from '../data/siteConfig';
import { assetUrl } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  isEditorial?: boolean;
  schemaJson?: Record<string, unknown>;
}

const {
  title = `${siteConfig.name} — ${siteConfig.tagline}`,
  description = `${siteConfig.name} — ${siteConfig.sub}`,
  ogImage = '/assets/hero_poster.webp',
  isEditorial = false,
  schemaJson = {
    "@context": "https://schema.org",
    "@type": "MusicGroup",
    "name": "Rite of Passage",
    "alternateName": "Rite of Passage",
    "url": "https://leonardolazza.github.io/rite_of_passage/",
    "logo": "https://leonardolazza.github.io/rite_of_passage/assets/logo_brand.png",
    "description": "Productora de vanguardia para eventos bespoke, galas exclusivas y bodas de alta gama.",
    "telephone": siteConfig.phone,
    "email": siteConfig.email,
    "member": [
      {
        "@type": "Person",
        "name": "Joa Lamtzev",
        "jobTitle": "Saxofonista Profesional y DJ Residente",
        "url": "https://leonardolazza.github.io/rite_of_passage/artistas/joa-lamtzev/"
      }
    ]
  }
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={assetUrl("/assets/favicon.png")} type="image/png" />

  <!-- Google Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Outfit:wght@300;400;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

  <!-- Core Stylesheets (100% Pixel-Perfect Match with original index.html & joah.html) -->
  {isEditorial ? (
    <link rel="stylesheet" href={`${assetUrl("/joah.css")}?v=3.2`} />
  ) : (
    <link rel="stylesheet" href={`${assetUrl("/styles.css")}?v=4.1`} />
  )}

  <!-- Open Graph / Social Sharing -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={assetUrl(ogImage)} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
</head>
<body class={isEditorial ? "joah-page" : ""}>

  <Header isEditorial={isEditorial} />
  <MobileDrawer isEditorial={isEditorial} />

  <main>
    <slot />
  </main>

  <Footer isEditorial={isEditorial} />

  <!-- WhatsApp CTA -->
  <WhatsAppButton customMessage={isEditorial ? "Hola, quisiera consultar disponibilidad para contratar a Joa Lamtzev" : undefined} />

  <script>
    // Header shrink on scroll
    const hdr = document.getElementById('hdr');
    if (hdr) {
      const onScroll = () => hdr.classList.toggle('scrolled', window.scrollY > 40);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    // Mobile Drawer Navigation (Editorial Luxury)
    const toggle = document.getElementById('menuToggle');
    const drawer = document.getElementById('mobileDrawer');
    const closeBtn = document.getElementById('drawerClose');
    const backdrop = document.getElementById('drawerBackdrop');
    const links = document.querySelectorAll('.mobile-link');

    if (toggle && drawer) {
      function openDrawer() {
        drawer.classList.add('open');
        drawer.setAttribute('aria-hidden', 'false');
        toggle.classList.add('active');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('drawer-open');
      }

      function closeDrawer() {
        drawer.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        toggle.classList.remove('active');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('drawer-open');
      }

      toggle.addEventListener('click', () => {
        const isOpen = drawer.classList.contains('open');
        if (isOpen) closeDrawer();
        else openDrawer();
      });

      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      if (backdrop) backdrop.addEventListener('click', closeDrawer);

      links.forEach(link => {
        link.addEventListener('click', closeDrawer);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('open')) {
          closeDrawer();
        }
      });
    }

    // Reveal on scroll (bidireccional continuo: anima al bajar y al subir)
    const reveals = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
          } else {
            const r = e.boundingClientRect;
            if (r.top > window.innerHeight || r.bottom < 0) {
              e.target.classList.remove('in');
            }
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(el => io.observe(el));
    } else {
      reveals.forEach(el => el.classList.add('in'));
    }
  </script>
</body>
</html>
