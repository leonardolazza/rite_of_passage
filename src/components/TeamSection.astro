---
import { artists } from '../data/artists';
import { assetUrl, siteLink } from '../utils/paths';
---

<!-- INTEGRANTES / TEAM FEATURE -->
<section class="team section-pad" id="team">
  <div class="wrap">
    <!-- SEPARADOR SUPERIOR -->
    <div class="section-divider">
      <div class="diamond"></div>
    </div>

    <div class="sec-head reveal">
      <span class="kicker">Nuestro Equipo</span>
      <h2>Nuestros grandes artistas</h2>
      <p>Las mentes y artesanos que transforman cada visión en una experiencia irrepetible.</p>
    </div>

    {artists.map((artist) => (
      <a href={siteLink(`/artistas/${artist.slug}`)} class="team-card reveal d1" id="teamCard" tabindex="0" style="text-decoration: none; color: inherit; cursor: pointer; display: grid;">
        <div class="team-media-wrap">
          <img src={assetUrl(artist.avatar)} alt={artist.name} loading="lazy" decoding="async" width="640" height="640" />
          <div class="team-overlay"></div>
        </div>
        <div class="team-content">
          <h3 class="team-name">{artist.name}</h3>
          <span class="team-role">{artist.role}</span>
          <p class="team-bio">“{artist.quote}”</p>
          <span class="team-link-cta" style="display: inline-block; margin-top: 15px; font-family: monospace; font-size: 0.8rem; color: #d4af37; letter-spacing: 1px; text-transform: uppercase; font-weight: bold; border-bottom: 1px solid #d4af37; padding-bottom: 2px;">Ver Dossier Completo →</span>
        </div>
      </a>
    ))}

    <!-- SEPARADOR INFERIOR -->
    <div class="section-divider">
      <div class="diamond"></div>
    </div>
  </div>
</section>
