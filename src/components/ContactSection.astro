---
import { siteConfig } from '../data/siteConfig';
---

<section class="contact section-pad" id="contact">
  <div class="wrap">
    <div class="contact-box">
      <div class="contact-grid">
        <div class="contact-info reveal">
          <h2>Inicia la conversación</h2>
          <p class="lead">Contanos el momento que imaginás. Te diremos cómo lo hacemos realidad — y solo tuyo.</p>
          <div class="detail">
            <div>
              <span class="k">Email</span>
              <a href={`mailto:${siteConfig.email}`} class="detail-email-link">{siteConfig.email}</a>
            </div>
            <div>
              <span class="k">Teléfono</span>
              <a href={`tel:${siteConfig.phone.replace(/[\s-]/g, '')}`} class="phone-link" title={`Llamar directamente (${siteConfig.phone})`}>
                {siteConfig.phone}
              </a>
            </div>
            <div>
              <span class="k">Estudio</span>
              <span>{siteConfig.studioLocation}</span>
            </div>
          </div>

          <!-- BOTÓN WHATSAPP DESTACADO -->
          <div class="contact-wa-row">
            <a
              href={`https://wa.me/${siteConfig.phoneRaw}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-wa-badge"
              title={`Abrir WhatsApp (${siteConfig.phone})`}
              aria-label="Contactar por WhatsApp"
            >
              <div class="wa-badge-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm0 18.15c-1.49 0-2.95-.4-4.23-1.16l-.3-.18-3.14.82.84-3.06-.2-.31c-.83-1.33-1.27-2.88-1.27-4.47 0-4.5 3.66-8.15 8.16-8.15 2.18 0 4.23.85 5.77 2.39 1.54 1.54 2.39 3.59 2.39 5.77 0 4.49-3.66 8.15-8.16 8.15z"/></svg>
              </div>
              <span class="wa-badge-text">WhatsApp</span>
            </a>
          </div>
        </div>

        <div class="reveal d1">
          <form id="enquiry" novalidate>
            <div class="field">
              <label for="name">Nombre Completo *</label>
              <input id="name" name="name" type="text" placeholder="Tu nombre y apellido" required />
              <span class="field-error" id="nameError" aria-live="polite"></span>
            </div>
            <div class="field">
              <label for="email">Correo Electrónico *</label>
              <input id="email" name="email" type="email" placeholder="ejemplo@atelier.com" required />
              <span class="field-error" id="emailError" aria-live="polite"></span>
            </div>
            <div class="field">
              <label for="type">Tipo de Experiencia</label>
              <select id="type" name="type">
                <option>Gala Privada</option>
                <option>Evento Corporativo</option>
                <option>Fiesta Exclusiva</option>
                <option>Experiencia a Medida</option>
                <option>Otro</option>
              </select>
            </div>
            <div class="field">
              <label for="msg">Tu Visión</label>
              <textarea id="msg" name="msg" placeholder="Contanos sobre el momento que imaginás…"></textarea>
            </div>
            <button class="btn btn-crimson" type="submit">Consultar Ahora</button>
            <p class="form-note">{siteConfig.responseWindow}</p>
          </form>

          <div class="form-ok" id="formOk">
            <span class="form-ok-diamond">✦</span>
            <h3>Propuesta Registrada</h3>
            <p id="formOkDesc">Gracias — tu visión está en manos de nuestro atelier. Nos pondremos en contacto contigo en breve para dar inicio al rito.</p>
            
            <div class="form-ok-actions">
              <span class="form-ok-sub">¿Deseás agilizar la comunicación?</span>
              <a id="formOkWaBtn" href="#" target="_blank" rel="noopener noreferrer" class="btn-wa-direct">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm0 18.15c-1.49 0-2.95-.4-4.23-1.16l-.3-.18-3.14.82.84-3.06-.2-.31c-.83-1.33-1.27-2.88-1.27-4.47 0-4.5 3.66-8.15 8.16-8.15 2.18 0 4.23.85 5.77 2.39 1.54 1.54 2.39 3.59 2.39 5.77 0 4.49-3.66 8.15-8.16 8.15z"/></svg>
                <span>Enviar resumen vía WhatsApp</span>
              </a>
              <button type="button" id="formResetBtn" class="form-reset-link">Enviar otra propuesta</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('enquiry') as HTMLFormElement | null;
  const ok = document.getElementById('formOk');
  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const typeSelect = document.getElementById('type') as HTMLSelectElement | null;
  const msgInput = document.getElementById('msg') as HTMLTextAreaElement | null;
  const nameError = document.getElementById('nameError');
  const emailError = document.getElementById('emailError');
  const formOkWaBtn = document.getElementById('formOkWaBtn') as HTMLAnchorElement | null;
  const formResetBtn = document.getElementById('formResetBtn');

  if (form && nameInput && emailInput) {
    [nameInput, emailInput].forEach(input => {
      input.addEventListener('input', () => {
        input.classList.remove('invalid');
        if (input === nameInput && nameError) {
          nameError.textContent = '';
          nameError.classList.remove('active');
        }
        if (input === emailInput && emailError) {
          emailError.textContent = '';
          emailError.classList.remove('active');
        }
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const type = typeSelect ? typeSelect.value : 'Evento';
      const msg = msgInput ? msgInput.value.trim() : '';
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

      let isValid = true;
      if (!name) {
        nameInput.classList.add('invalid');
        if (nameError) {
          nameError.textContent = 'Por favor ingresá tu nombre completo.';
          nameError.classList.add('active');
        }
        isValid = false;
      }
      if (!email || !emailOk) {
        emailInput.classList.add('invalid');
        if (emailError) {
          emailError.textContent = 'Ingresá un correo electrónico válido.';
          emailError.classList.add('active');
        }
        isValid = false;
      }

      if (!isValid) {
        if (!name) nameInput.focus();
        else emailInput.focus();
        return;
      }

      const waText = `Hola Rite of Passage, mi nombre es ${name} (${email}). Me pongo en contacto para consultar disponibilidad y propuesta para: *${type}*.\n\nNuestra visión: ${msg || 'A coordinar'}`;
      const waUrl = `https://wa.me/5492914074772?text=${encodeURIComponent(waText)}`;

      if (formOkWaBtn) formOkWaBtn.href = waUrl;
      form.style.display = 'none';
      if (ok) {
        ok.classList.add('show');
        ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    if (formResetBtn) {
      formResetBtn.addEventListener('click', () => {
        form.reset();
        form.style.display = 'block';
        if (ok) ok.classList.remove('show');
        nameInput.focus();
      });
    }
  }
</script>
