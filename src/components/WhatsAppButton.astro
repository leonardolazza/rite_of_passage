---
// WhatsAppButton.astro — Floating Persistent WhatsApp CTA
import { siteConfig } from '../data/siteConfig';

interface Props {
  customMessage?: string;
}

const {
  customMessage = "Hola, quisiera consultar disponibilidad para un evento bespoke"
} = Astro.props;

const phoneDigits = siteConfig.phone.replace(/[^0-9]/g, '');
const whatsappUrl = `https://wa.me/${phoneDigits}?text=${encodeURIComponent(customMessage)}`;
---

<a 
  href={whatsappUrl} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="whatsapp-float-btn" 
  aria-label="Consultar por WhatsApp"
>
  <svg viewBox="0 0 24 24">
    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 17.65c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a7.88 7.88 0 0 1-1.22-4.2c0-4.36 3.55-7.91 7.91-7.91 2.11 0 4.1.82 5.6 2.31a7.854 7.854 0 0 1 2.31 5.6c0 4.36-3.55 7.91-7.91 7.91zm4.33-5.93c-.24-.12-1.41-.7-1.63-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.18-.71-.63-1.19-1.41-1.33-1.65-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.41-.54-.42l-.46-.01c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.52.1.46-.07 1.41-.58 1.61-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28z"></path>
  </svg>
  <span>Consultar WhatsApp</span>
</a>
