---
import { siteConfig } from '../data/siteConfig';
---

<!-- THE RITE / SYMBOLISM -->
<!-- PULL QUOTE -->
<section class="pull">
  <div class="pull-bg-slides" aria-hidden="true">
    <div class="pull-slide pull-s1"></div>
    <div class="pull-slide pull-s2"></div>
    <div class="pull-slide pull-s3"></div>
  </div>
  <div class="wrap">
    <span class="tag reveal">El Rito</span>
    <blockquote class="reveal d1">Algunos momentos se recuerdan toda la vida. <span class="accent">Nosotros los hacemos realidad.</span></blockquote>
    <p class="from reveal d2">{siteConfig.name}</p>
  </div>
</section>
