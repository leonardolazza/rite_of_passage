---
import { siteConfig } from '../data/siteConfig';
import { assetUrl, siteLink } from '../utils/paths';
---

<div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
  <div class="mobile-drawer-backdrop" id="drawerBackdrop"></div>
  <div class="mobile-drawer-panel">
    <div class="mobile-drawer-header">
      <div class="brand">
        <img src={assetUrl("/assets/logo_icon.png")} alt={siteConfig.name} />
        <span class="name">{siteConfig.name}</span>
      </div>
      <button class="drawer-close" id="drawerClose" aria-label="Cerrar menú">×</button>
    </div>
    <div class="drawer-divider"></div>
    <nav class="mobile-nav-links">
      <a class="mobile-link" href={siteLink("/#top")}><span class="m-num">01</span><span>Inicio</span></a>
      <a class="mobile-link" href={siteLink("/#philosophy")}><span class="m-num">02</span><span>Filosofía</span></a>
      <a class="mobile-link" href={siteLink("/#about")}><span class="m-num">03</span><span>Quiénes Somos</span></a>
      <a class="mobile-link" href={siteLink("/#experiences")}><span class="m-num">04</span><span>Servicios</span></a>
      <a class="mobile-link" href={siteLink("/#team")}><span class="m-num">05</span><span>Nuestros Artistas</span></a>
      <a class="mobile-link" href={siteLink("/#social")}><span class="m-num">06</span><span>Comunidad & Redes</span></a>
      <a class="mobile-link" href={siteLink("/#contact")}><span class="m-num">07</span><span>Contacto</span></a>
    </nav>
    <div class="drawer-footer">
      <a class="btn btn-crimson drawer-cta" href={siteLink("/#contact")}>Inicia tu Rito</a>
      <a class="drawer-wa-btn" href={`https://wa.me/${siteConfig.phoneRaw}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm0 18.15c-1.49 0-2.95-.4-4.23-1.16l-.3-.18-3.14.82.84-3.06-.2-.31c-.83-1.33-1.27-2.88-1.27-4.47 0-4.5 3.66-8.15 8.16-8.15 2.18 0 4.23.85 5.77 2.39 1.54 1.54 2.39 3.59 2.39 5.77 0 4.49-3.66 8.15-8.16 8.15z"/></svg>
        <span>Chat Directo por WhatsApp</span>
      </a>
    </div>
  </div>
</div>
