---
import { siteConfig } from '../data/siteConfig';
import { withBase } from '../utils/paths';

interface Props {
  currentPath?: string;
  isEditorial?: boolean;
}

const { currentPath = '/', isEditorial = false } = Astro.props;
---

{isEditorial ? (
  <header class="editorial-header">
    <a href={withBase('/#team')} class="back-link">← Volver</a>
    <a href="#" class="brand-logo">JOA LAMTZEV</a>
  </header>
) : (
  <header id="hdr">
    <a class="brand" href="#top" aria-label={`${siteConfig.name} home`}>
      <img src={withBase('/assets/logo_icon.png')} alt={`${siteConfig.name} emblem`} />
      <span class="name">{siteConfig.name}</span>
    </a>
    <nav class="top">
      <a class="link" href="#philosophy">Filosofía</a>
      <a class="link" href="#about">Quiénes Somos</a>
      <a class="link" href="#experiences">Servicios</a>
      <a class="link" href="#team">Artistas</a>
      <a class="btn btn-crimson" href="#contact">Consultar Ahora</a>
    </nav>
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="mobileDrawer">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </header>
)}
