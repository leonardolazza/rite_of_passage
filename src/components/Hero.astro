---
import { siteConfig } from '../data/siteConfig';
import { withBase } from '../utils/paths';
---

<!-- HERO -->
<section class="hero" id="top">
  <video class="hero-media" autoplay muted loop playsinline poster={withBase('/assets/hero_poster.webp')} aria-hidden="true">
    <source src={withBase('/assets/hero_video.webm')} type="video/webm">
    <source src={withBase('/assets/hero_video.mp4')} type="video/mp4">
  </video>
  <div class="wrap hero-center">
    <img class="brandmark" src={withBase('/assets/logo_brand.png')} alt={siteConfig.name} />
    <span class="eyebrow reveal">{siteConfig.eyebrow}</span>
    <h1 class="reveal d1">ARQUITECTURA SONORA DE <span class="accent">VANGUARDIA</span></h1>
    <p class="sub reveal d2">{siteConfig.sub}</p>
    <div class="cta-row reveal d3">
      <a class="btn btn-crimson" href="#contact">Inicia tu Rito</a>
      <a class="btn btn-ghost" href="#experiences">Servicios que Ofrecemos</a>
    </div>
  </div>
</section>
