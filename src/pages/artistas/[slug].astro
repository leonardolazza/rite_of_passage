---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { artists, type ArtistProfile } from '../../data/artists';
import { siteConfig } from '../../data/siteConfig';
import { assetUrl } from '../../utils/paths';

export async function getStaticPaths() {
  return artists.map(artist => ({
    params: { slug: artist.slug },
    props: { artist }
  }));
}

interface Props {
  artist: ArtistProfile;
}

const { artist } = Astro.props;
---

<BaseLayout
  title={`${artist.name} — ${artist.role} | ${siteConfig.name} Atelier`}
  description={artist.heroParagraph}
  ogImage={artist.avatar}
  isEditorial={true}
>
  <!-- HERO ASIMÉTRICO (EDITORIAL LUXURY) -->
  <section class="editorial-hero" id="top">
    <div class="hero-text-col">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        {artist.badge}
      </div>
      <h1 class="hero-headline">
        La elegancia del <em>{artist.headlineEm}</em> contemporáneo.
      </h1>
      <p class="hero-paragraph">
        {artist.heroParagraph}
      </p>
      <div class="hero-cta-group">
        <a href={`https://wa.me/${siteConfig.phoneRaw}?text=${encodeURIComponent(`Hola, quisiera consultar disponibilidad para contratar a ${artist.name}.`)}`} target="_blank" class="btn-gold-sm" style="font-size: 0.85rem; padding: 12px 28px;">Solicitar Artista</a>
        <a href="#formatos" class="btn-outline-gold">Explorar Propuestas</a>
      </div>
    </div>
    
    <div class="hero-media-wrapper">
      <!-- CINEMATIC CROSSFADE SLIDESHOW -->
      <div class="hero-crossfade-stage" id="heroCrossfadeStage">
        {artist.slideshow.map((slideSrc, idx) => (
          <div class={`hero-slide ${idx === 0 ? 'active' : ''}`} data-src={assetUrl(slideSrc)}>
            <img src={assetUrl(slideSrc)} alt={`${artist.name} ${idx + 1}`} fetchpriority={idx === 0 ? "high" : "auto"} loading={idx === 0 ? "eager" : "lazy"} decoding="async" />
          </div>
        ))}

        <!-- Flechas de Navegación (Control Manual de Fotos) -->
        <button class="hero-slide-nav hero-slide-prev" id="heroSlidePrev" aria-label="Foto anterior" type="button">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="hero-slide-nav hero-slide-next" id="heroSlideNext" aria-label="Siguiente foto" type="button">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <!-- Indicador de Progreso Discreto en la Base -->
        <div class="hero-slide-progress" id="heroSlideProgress">
          {artist.slideshow.map((_, idx) => (
            <div class={`slide-dot ${idx === 0 ? 'active' : ''}`} data-index={idx}></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- MANIFIESTO ARTÍSTICO -->
  <section class="section-manifesto" id="manifiesto" style={`background-image: linear-gradient(180deg, rgba(7, 7, 9, 0.88) 0%, rgba(7, 7, 9, 0.68) 50%, rgba(7, 7, 9, 0.96) 100%), radial-gradient(circle at center, rgba(128, 14, 46, 0.48) 0%, transparent 80%), url('${assetUrl(artist.manifestoBg)}');`}>
    <div class="manifesto-title">
      “{artist.quote}”
    </div>
    <div class="manifesto-author">— {artist.name}</div>
  </section>

  <!-- FORMATOS DE SHOW (EXPERIENCIAS SONORAS BESPOKE) -->
  <section class="section-formats" id="formatos">
    <div class="formats-header">
      <div>
        <span class="fmt-kicker">Formatos de Actuación</span>
        <h2 class="fmt-title">
          Experiencias Sonoras
          <span class="fmt-title-sub">Bespoke</span>
        </h2>
      </div>
      <div class="formats-header-right">
        <div class="fmt-header-line"></div>
        <p class="fmt-header-desc">Propuestas escénicas personalizadas para elevar cada atmósfera al máximo estándar.</p>
      </div>
    </div>

    <div class="fmt-cards-grid">
      {artist.formats.map((fmt) => (
        <div class="fmt-card">
          <div class="fmt-card-bg">
            <img src={assetUrl(fmt.image)} alt={fmt.title} loading="lazy" decoding="async" />
          </div>
          <div class="fmt-card-overlay"></div>
          <div class="fmt-card-num">{fmt.number}</div>
          {fmt.pill && (
            <div class={`fmt-card-pill ${fmt.pillStyle === 'crimson' ? 'fmt-pill-crimson' : ''}`}>{fmt.pill}</div>
          )}
          <div class="fmt-card-content">
            <h3>{fmt.title}</h3>
            <div class={`fmt-soundwave ${fmt.pillStyle === 'crimson' ? 'crimson-wave' : ''}`}>
              <div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div>
              <div class="wave-bar"></div><div class="wave-bar"></div><div class="wave-bar"></div>
            </div>
            <p>{fmt.description}</p>
            <a href={`https://wa.me/${siteConfig.phoneRaw}?text=${encodeURIComponent(fmt.waMessage)}`} target="_blank" class={`fmt-card-cta ${fmt.pillStyle === 'crimson' ? 'fmt-cta-crimson' : ''}`}>
              {fmt.cta}
            </a>
          </div>
          <div class={`fmt-card-bar ${fmt.pillStyle === 'crimson' ? 'fmt-bar-crimson' : ''}`}></div>
        </div>
      ))}
    </div>
  </section>

  <!-- SECCIÓN: SESIÓN EN VIVO (AUDIO PLAYER INTERACTIVO) -->
  {artist.featuredTrack && (
    <section class="section-live-session" id="sesion-en-vivo">
      <div class="session-header">
        <div>
          <h2 class="fmt-title">
            Live Atelier Session
            <span class="fmt-title-sub">{artist.featuredTrack.title} — {artist.featuredTrack.originalArtist}</span>
          </h2>
        </div>
        <div class="formats-header-right">
          <div class="fmt-header-line"></div>
          <p class="fmt-header-desc">Registro sonoro en directo. Escuchá la fusión de virtuosismo de saxofón contemporáneo y elegancia escénica.</p>
        </div>
      </div>

      <div class="session-card" id="sessionPlayerCard">
        <!-- AMBIENT GLOW DECORATIONS -->
        <div class="session-card-glow"></div>

        <!-- COLUMNA IZQUIERDA: ARTWORK -->
        <div class="session-artwork-col">
          <div class="session-cover-frame">
            <img
              src={assetUrl(artist.featuredTrack.cover)}
              alt={`${artist.featuredTrack.title} - ${artist.name}`}
              class="session-cover-img"
              loading="lazy"
              decoding="async"
            />
            <div class="cover-gradient-overlay"></div>
          </div>
        </div>

        <!-- COLUMNA DERECHA: REPRODUCTOR Y DETALLES -->
        <div class="session-player-col">
          <div class="session-meta-top">
            <span class="session-duration-tag">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.2 3.1.8-1.3-4.5-2.7V7z"/>
              </svg>
              {artist.featuredTrack.duration}
            </span>
          </div>

          <h3 class="session-track-title">{artist.featuredTrack.title}</h3>
          <p class="session-track-artist">Reinterpretación por <strong>{artist.name}</strong> · Tema original: <em>{artist.featuredTrack.originalArtist}</em></p>

          <p class="session-track-desc">{artist.featuredTrack.description}</p>

          <!-- AUDIO ELEMENT -->
          <audio
            id="featuredAudioElement"
            src={assetUrl(artist.featuredTrack.audioSrc)}
            preload="metadata"
          ></audio>

          <!-- REPRODUCTOR INTERACTIVO CUSTOM -->
          <div class="custom-player-widget">
            <div class="player-controls-row">
              <!-- BOTÓN PLAY / PAUSE PRINCIPAL -->
              <button class="player-play-btn" id="audioPlayBtn" type="button" aria-label="Reproducir pista">
                <svg class="play-icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <svg class="pause-icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" style="display: none;">
                  <rect x="6" y="4" width="4" height="16"></rect>
                  <rect x="14" y="4" width="4" height="16"></rect>
                </svg>
              </button>

              <!-- DISPLAY TIEMPO Y TRACKBAR -->
              <div class="player-timeline-wrap">
                <div class="player-time-display">
                  <span id="currentTimeDisplay" class="time-elapsed">00:00</span>
                  <span class="time-separator">/</span>
                  <span id="totalDurationDisplay" class="time-total">{artist.featuredTrack.duration}</span>
                </div>
                <div class="player-progress-bar" id="audioProgressBar" role="slider" aria-label="Progreso del audio" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
                  <div class="progress-fill" id="audioProgressFill"></div>
                  <div class="progress-handle" id="audioProgressHandle"></div>
                </div>
              </div>

              <!-- CONTROL DE VOLUMEN -->
              <div class="player-volume-wrap">
                <button class="player-mute-btn" id="audioMuteBtn" type="button" aria-label="Silenciar / Activar sonido">
                  <svg class="vol-icon-high" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                  </svg>
                  <svg class="vol-icon-muted" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <line x1="23" y1="9" x2="17" y2="15"></line>
                    <line x1="17" y1="9" x2="23" y2="15"></line>
                  </svg>
                </button>
                <input type="range" class="player-volume-slider" id="audioVolumeSlider" min="0" max="1" step="0.05" value="1" aria-label="Volumen" />
              </div>
            </div>
          </div>

          <!-- CTAS DE ACCIÓN: CONTRATAR + VER EN INSTAGRAM -->
          <div class="session-actions-row">
            <a
              href={`https://wa.me/${siteConfig.phoneRaw}?text=${encodeURIComponent(`Hola Joa / Rite of Passage, escuché la sesión en vivo de Blinding Lights y quisiera consultar este formato para un evento.`)}`}
              target="_blank"
              class="btn-gold-sm"
              style="font-size: 0.85rem; padding: 12px 24px;"
            >
              Consultar Formato Sax Live
            </a>
            <a
              href={artist.featuredTrack.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-session-instagram"
              title="Ver en Instagram"
              aria-label="Ver video en Instagram"
              style="width: 46px; height: 46px; min-width: 46px; min-height: 46px; border-radius: 50%; aspect-ratio: 1 / 1; display: inline-flex; align-items: center; justify-content: center; padding: 0;"
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.13-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- TRAYECTORIA, FORMACIÓN Y CREDENCIALES -->
  <section class="section-credentials" id="trayectoria">
    <div class="credentials-wrap">
      <span class="sec-tag">Trayectoria & Formación</span>
      <h2 class="sec-title">Respaldo Académico y Experiencia</h2>

      <div class="credentials-grid">
        <!-- FORMACIÓN -->
        <div class="cred-box">
          <h3><span>🎷</span> {artist.credentials.educationTitle}</h3>
          <ul class="cred-list">
            {artist.credentials.education.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <!-- MARCAS & VENUES -->
        <div class="cred-box">
          <h3><span>✨</span> {artist.credentials.venuesTitle}</h3>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 12px;">{artist.credentials.venuesSubtitle}</p>
          <div class="brand-tags-flex">
            {artist.credentials.venues.map(v => (
              <span class="brand-chip">{v}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- EQUIPAMIENTO TÉCNICO -->
      <div class="tech-rider-box">
        <div class="tech-rider-info">
          <h4>{artist.credentials.techRider.title}</h4>
          <p>{artist.credentials.techRider.description}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- APARTADO INSTAGRAM OFICIAL -->
  <section class="section-instagram" id="instagram">
    <div class="insta-container">
      <div class="insta-left">
        <div class="insta-badge">
          <span class="insta-icon-grad">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.13-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </span>
          INSTAGRAM OFICIAL · {artist.instagram.handle.toUpperCase()}
        </div>
        <h2 class="insta-headline">{artist.instagram.headline}</h2>
        <p class="insta-desc">{artist.instagram.desc}</p>

        <div class="insta-stats-mini">
          {artist.instagram.stats.map(st => (
            <div class="insta-stat-item">
              <span class="insta-stat-val">{st.val}</span>
              <span class="insta-stat-lbl">{st.lbl}</span>
            </div>
          ))}
        </div>

        <a href={artist.instagram.url} target="_blank" class="btn-insta-vip">
          <span>Seguir {artist.instagram.handle} en Instagram</span>
        </a>
      </div>

      <div class="insta-phone-wrap">
        <div class="phone-mockup">
          <div class="phone-island"><div class="phone-camera"></div></div>
          <div class="phone-glass-glare"></div>
          <div class="phone-screen">
            <img src={assetUrl(artist.instagram.mockupImage)} alt={`Instagram ${artist.name}`} loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Hero Slideshow Crossfade Logic
  const stage = document.getElementById('heroCrossfadeStage');
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.slide-dot');

  if (slides.length && dots.length) {
    let currentSlide = 0;
    let slideInterval: any = null;
    const slideDuration = 4500;

    function setSlide(index: number) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentSlide = index;

      slides.forEach((s, i) => {
        s.classList.toggle('active', i === currentSlide);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('active', i === currentSlide);
      });
    }

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-index') || 0);
        setSlide(idx);
        resetAutoPlay();
      });
    });

    const prevBtn = document.getElementById('heroSlidePrev');
    const nextBtn = document.getElementById('heroSlideNext');

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setSlide(currentSlide - 1);
        resetAutoPlay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        setSlide(currentSlide + 1);
        resetAutoPlay();
      });
    }

    function nextSlide() {
      setSlide(currentSlide + 1);
    }

    function startAutoPlay() {
      if (!slideInterval) {
        slideInterval = setInterval(nextSlide, slideDuration);
      }
    }

    function stopAutoPlay() {
      if (slideInterval) {
        clearInterval(slideInterval);
        slideInterval = null;
      }
    }

    function resetAutoPlay() {
      stopAutoPlay();
      startAutoPlay();
    }

    if (stage) {
      stage.addEventListener('mouseenter', stopAutoPlay);
      stage.addEventListener('mouseleave', startAutoPlay);

      let touchStartX = 0;
      stage.addEventListener('touchstart', (e: any) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAutoPlay();
      }, { passive: true });
      stage.addEventListener('touchend', (e: any) => {
        const diff = e.changedTouches[0].screenX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) nextSlide();
          else setSlide(currentSlide - 1);
        }
        startAutoPlay();
      }, { passive: true });
    }

    startAutoPlay();
  }

  // Kinetic 3D Cards Tilt Logic (Desktop Mouse + Mobile Touch Drag)
  document.querySelectorAll('.fmt-card').forEach((card: any) => {
    // Mouse hover tilt (Desktop)
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const rx = ((e.clientY - cy) / (rect.height / 2)) * -8;
      const ry = ((e.clientX - cx) / (rect.width / 2)) * 10;
      card.style.transform = `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg) scale(1.02)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale(1)';
      card.style.transition = 'transform .6s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease';
    });
    card.addEventListener('mouseenter', () => {
      card.style.transition = 'transform .1s ease, box-shadow .4s ease';
    });

    // Touch tilt on mobile swipe / touch (cuando se les pasa el dedo)
    function applyTouchTilt(touch: Touch) {
      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const rx = Math.max(-12, Math.min(12, ((touch.clientY - cy) / (rect.height / 2)) * -10));
      const ry = Math.max(-14, Math.min(14, ((touch.clientX - cx) / (rect.width / 2)) * 12));
      card.style.transform = `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg) scale(1.03)`;
    }

    card.addEventListener('touchstart', (e: TouchEvent) => {
      if (!e.touches || !e.touches[0]) return;
      card.classList.add('touch-active');
      card.style.transition = 'transform .08s ease-out, box-shadow .3s ease';
      applyTouchTilt(e.touches[0]);
    }, { passive: true });

    card.addEventListener('touchmove', (e: TouchEvent) => {
      if (!e.touches || !e.touches[0]) return;
      applyTouchTilt(e.touches[0]);
    }, { passive: true });

    const endTouch = () => {
      card.classList.remove('touch-active');
      card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale(1)';
      card.style.transition = 'transform .6s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease';
    };

    card.addEventListener('touchend', endTouch, { passive: true });
    card.addEventListener('touchcancel', endTouch, { passive: true });
  });

  // Custom Live Session Audio Player Controller
  const audio = document.getElementById('featuredAudioElement') as HTMLAudioElement | null;
  const playBtn = document.getElementById('audioPlayBtn');
  const playIcon = playBtn?.querySelector('.play-icon') as HTMLElement | null;
  const pauseIcon = playBtn?.querySelector('.pause-icon') as HTMLElement | null;
  const playerCard = document.getElementById('sessionPlayerCard');
  const progressBar = document.getElementById('audioProgressBar');
  const progressFill = document.getElementById('audioProgressFill');
  const progressHandle = document.getElementById('audioProgressHandle');
  const currentTimeDisplay = document.getElementById('currentTimeDisplay');
  const totalDurationDisplay = document.getElementById('totalDurationDisplay');
  const volumeSlider = document.getElementById('audioVolumeSlider') as HTMLInputElement | null;
  const muteBtn = document.getElementById('audioMuteBtn');
  const volIconHigh = muteBtn?.querySelector('.vol-icon-high') as HTMLElement | null;
  const volIconMuted = muteBtn?.querySelector('.vol-icon-muted') as HTMLElement | null;

  if (audio && playBtn && progressBar && progressFill) {
    function formatTime(seconds: number) {
      if (isNaN(seconds) || seconds < 0) return '00:00';
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
    }

    function updatePlayState(isPlaying: boolean) {
      if (isPlaying) {
        if (playIcon) playIcon.style.display = 'none';
        if (pauseIcon) pauseIcon.style.display = 'block';
        if (playerCard) playerCard.classList.add('is-playing');
        playBtn?.setAttribute('aria-label', 'Pausar pista');
      } else {
        if (playIcon) playIcon.style.display = 'block';
        if (pauseIcon) pauseIcon.style.display = 'none';
        if (playerCard) playerCard.classList.remove('is-playing');
        playBtn?.setAttribute('aria-label', 'Reproducir pista');
      }
    }

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().then(() => updatePlayState(true)).catch((err) => {
          console.warn('Audio playback error:', err);
        });
      } else {
        audio.pause();
        updatePlayState(false);
      }
    });

    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      progressFill.style.width = `${pct}%`;
      if (progressHandle) progressHandle.style.left = `${pct}%`;
      if (currentTimeDisplay) currentTimeDisplay.textContent = formatTime(audio.currentTime);
      progressBar.setAttribute('aria-valuenow', Math.round(pct).toString());
    });

    audio.addEventListener('loadedmetadata', () => {
      if (totalDurationDisplay && !isNaN(audio.duration) && audio.duration > 0) {
        totalDurationDisplay.textContent = formatTime(audio.duration);
      }
    });

    audio.addEventListener('ended', () => {
      updatePlayState(false);
      progressFill.style.width = '0%';
      if (progressHandle) progressHandle.style.left = '0%';
      if (currentTimeDisplay) currentTimeDisplay.textContent = '00:00';
    });

    audio.addEventListener('pause', () => {
      updatePlayState(false);
    });

    audio.addEventListener('play', () => {
      updatePlayState(true);
    });

    // Seek scrubber logic
    function seek(e: MouseEvent | TouchEvent) {
      const rect = progressBar!.getBoundingClientRect();
      const clientX = 'touches' in e && e.touches[0] ? e.touches[0].clientX : (e as MouseEvent).clientX;
      const clickPos = Math.max(0, Math.min(rect.width, clientX - rect.left));
      const percentage = clickPos / rect.width;
      if (audio.duration) {
        audio.currentTime = percentage * audio.duration;
      }
    }

    let isSeeking = false;
    progressBar.addEventListener('mousedown', (e) => {
      isSeeking = true;
      seek(e);
    });
    window.addEventListener('mousemove', (e) => {
      if (isSeeking) seek(e);
    });
    window.addEventListener('mouseup', () => {
      if (isSeeking) isSeeking = false;
    });

    progressBar.addEventListener('touchstart', (e) => {
      isSeeking = true;
      seek(e);
    }, { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (isSeeking) seek(e);
    }, { passive: true });
    window.addEventListener('touchend', () => {
      if (isSeeking) isSeeking = false;
    });

    // Keyboard navigation
    progressBar.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        audio.currentTime = Math.max(0, audio.currentTime - 5);
      } else if (e.key === 'ArrowRight') {
        audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 5);
      } else if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        playBtn.click();
      }
    });

    // Volume controls
    function updateVolumeIcons() {
      const isMuted = audio!.muted || audio!.volume === 0;
      if (volIconHigh) volIconHigh.style.display = isMuted ? 'none' : 'block';
      if (volIconMuted) volIconMuted.style.display = isMuted ? 'block' : 'none';
    }

    if (volumeSlider) {
      volumeSlider.addEventListener('input', () => {
        const val = parseFloat(volumeSlider.value);
        audio.volume = val;
        audio.muted = (val === 0);
        updateVolumeIcons();
      });
    }

    let prevVolume = 1;
    muteBtn?.addEventListener('click', () => {
      if (audio.muted || audio.volume === 0) {
        audio.muted = false;
        audio.volume = prevVolume || 1;
        if (volumeSlider) volumeSlider.value = audio.volume.toString();
      } else {
        prevVolume = audio.volume;
        audio.muted = true;
        if (volumeSlider) volumeSlider.value = '0';
      }
      updateVolumeIcons();
    });
  }
</script>
